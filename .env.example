# Database Connection (from Neon)
# Get from: https://console.neon.tech/
# Format: postgresql://user:password@host/database
DATABASE_URL=postgresql://

# NextAuth Configuration
# Generate secret with: openssl rand -base64 32
NEXTAUTH_SECRET=your-random-secret-here

# Application URL
# Development: http://localhost:3000
# Production: https://yoursite.com
NEXTAUTH_URL=http://localhost:3000

# Optional: Cron Job Security
# Token for securing the /api/cron/daily-sync endpoint
# Only needed if using external cron services
CRON_SECRET=your-cron-secret-token

# Optional: GitHub Token
# Only if you want higher rate limits (not required for public data)
# Get from: https://github.com/settings/tokens
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# Optional: Analytics & Monitoring
# VERCEL_ANALYTICS_ID=your-analytics-id
# SENTRY_AUTH_TOKEN=your-sentry-token
